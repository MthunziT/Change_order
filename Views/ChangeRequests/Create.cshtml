@using Change_order.Models
@using Change_order.Services
@model Change_order.Models.ChangeRequest
@* @model ChangeRequest *@
@{
    ViewData["Title"] = "New Change Request";
}
@{
    bool isResubmit = ViewBag.IsResubmit == true;
    string? pendingComment = ViewBag.PendingComment as string;
}

<div class="page-header">
    <div>
        <h1 class="page-title">
            @(isResubmit ? "Edit & Resubmit Change Request" : "Project Change Request")
        </h1>
        <p class="page-subtitle">City of Johannesburg Municipality Property Branch</p>
    </div>
    <a href="@(isResubmit ? $"/ChangeRequests/Details/{Model.Id}" : "/Dashboard")" class="btn-secondary">← Back</a>
</div>

<form asp-action="@(isResubmit ? "SaveResubmit" : "Create")"
      asp-controller="ChangeRequests"
      method="post" class="cr-form">
    @Html.AntiForgeryToken()
    @if (isResubmit)
    {
        <input type="hidden" name="Id" value="@Model.Id" />
    }

    <div class="form-sections">

        <!-- ══ SECTION 1: Change Request Identification — UNCHANGED ══ -->
        <div class="form-section">
            <div class="section-header" style="background:#d9d9d9;border:1px solid #a6a6a6;padding:8px 12px;margin-bottom:0">
                <span class="section-num">01</span>
                <h2 style="margin:0;font-size:1rem">Change Request Identification</h2>
            </div>
            <div class="form-grid" style="border:1px solid #a6a6a6;border-top:none;padding:16px">
                <div class="form-group col-2">
                    <label asp-for="Name" style="font-weight:700">Change Request Name *</label>
                    <input asp-for="Name" class="form-input" placeholder="e.g. Send Email Notification for Awaiting Information Status" />
                    <span asp-validation-for="Name" class="field-error"></span>
                </div>

                @{
                    var systems = ViewBag.Systems as List<string> ?? new List<string>();
                }

                <div class="form-group col-2">
                    <label asp-for="ApplicationName" style="font-weight:700">
                        Application / System *
                    </label>

                    <select id="appSelect"
                            class="form-input"
                            onchange="handleAppChange()"
                            style="margin-bottom:8px">

                        <option value="">— Select application —</option>

                        @foreach (var sys in systems)
                        {
                            if (Model?.ApplicationName == sys)
                            {
                                <option value="@sys" selected>@sys</option>
                            }
                            else
                            {
                                <option value="@sys">@sys</option>
                            }
                        }

                        <option value="Other">Other</option>
                    </select>

                    <input asp-for="ApplicationName"
                           id="appNameInput"
                           class="form-input"
                           placeholder="Enter application name..."
                           style="display:none"
                           autocomplete="off" />

                    <span asp-validation-for="ApplicationName" class="field-error"></span>
                </div>
              
                <div class="form-group col-1">
                    <label asp-for="Priority" style="font-weight:700">Priority *</label>
                    <select asp-for="Priority" class="form-input" asp-items="Html.GetEnumSelectList<Priority>()">
                        <option value="">Select...</option>
                    </select>
                    <span asp-validation-for="Priority" class="field-error"></span>
                </div>
                <div class="form-group col-1">
                    <label asp-for="Impact" style="font-weight:700">Impact Level *</label>
                    <select asp-for="Impact" class="form-input" asp-items="Html.GetEnumSelectList<ImpactLevel>()">
                        <option value="">Select...</option>
                    </select>
                    <span asp-validation-for="Impact" class="field-error"></span>
                </div>
                <div class="form-group col-1">
                    <label asp-for="Category" style="font-weight:700">Change Request Category *</label>
                    <select asp-for="Category" class="form-input" asp-items="Html.GetEnumSelectList<ChangeCategory>()">
                        <option value="">Select...</option>
                    </select>
                    <span asp-validation-for="Category" class="field-error"></span>
                </div>
                <div class="form-group col-1">
                    <label asp-for="Environment" style="font-weight:700">Environment</label>
                    <select asp-for="Environment" class="form-input" asp-items="Html.GetEnumSelectList<DeploymentEnvironment>()">
                        <option value="">Select...</option> 
                    </select>
                    <span asp-validation-for="Environment" class="field-error"></span>
                </div>
            </div>
        </div>

        <!-- ══ SECTION 2: Change Request Description ══ -->
        <div class="form-section">
            <div class="section-header" style="background:#d9d9d9;border:1px solid #a6a6a6;padding:8px 12px;margin-bottom:0">
                <span class="section-num">02</span>
                <h2 style="margin:0;font-size:1rem">Change Request Description <span style="font-weight:400;font-size:0.85rem">(completed by the submitting party)</span></h2>
            </div>
            <div class="form-grid" style="border:1px solid #a6a6a6;border-top:none;padding:16px">
                <div class="form-group col-2">
                    <label asp-for="Description" style="font-weight:700">Change Request Description *</label>
                    <textarea asp-for="Description" class="form-input" rows="5"
                              placeholder="Describe what changes will be made and what the system will do differently..."></textarea>
                    <span asp-validation-for="Description" class="field-error"></span>
                </div>
                <div class="form-group col-2">
                    <label asp-for="BusinessJustification" style="font-weight:700">Business Justification *</label>
                    <textarea asp-for="BusinessJustification" class="form-input" rows="4"
                              placeholder="Why is this change necessary? What problem does it solve?"></textarea>
                    <span asp-validation-for="BusinessJustification" class="field-error"></span>
                </div>
            </div>
        </div>

        <!-- ══ SECTION 3: Impact & Proposed Response ══ -->
        <div class="form-section">
            <div class="section-header" style="background:#d9d9d9;border:1px solid #a6a6a6;padding:8px 12px;margin-bottom:0">
                <span class="section-num">03</span>
                <h2 style="margin:0;font-size:1rem">Change Request Impact &amp; Proposed Response <span style="font-weight:400;font-size:0.85rem">(from submitting party's perspective)</span></h2>
            </div>
            <div class="form-grid" style="border:1px solid #a6a6a6;border-top:none;padding:16px">

                <div class="form-group  col-2">
                    <label asp-for="AreasImpacted" style=" font-weight:700">
                        Areas Impacted
                        <span style="font-weight:400;font-size:0.8rem">(if change is implemented as requested)</span>
                    </label>
                    <textarea asp-for="AreasImpacted" class="form-input" rows="3"
                              placeholder="Who it impacts: Valuation Admin, Valuation Admin Supervisor, Clients. Area it impacts: Late Condonation system"></textarea>
                </div>

                <div class="form-group col-2">
                    <label asp-for="ImpactDescription" style="font-weight:700">
                        Impact Description
                        <span style="font-weight:400;font-size:0.8rem">(if change is implemented as requested)</span>
                    </label>
                    <textarea asp-for="ImpactDescription" class="form-input" rows="3"
                              placeholder="Who and what will be impacted? e.g. Clients will receive immediate notifications..."></textarea>
                </div>

                <div class="form-group col-2">
                    <label asp-for="ImpactIfNotDone" style="font-weight:700">  
                        Impact of Not Making the Change
                    </label>
                    <textarea asp-for="ImpactIfNotDone" class="form-input" rows="3"
                              placeholder="What risks or inefficiencies will persist if this change is not made?"></textarea>
                </div>

                <div class="form-group col-2">
                    <label asp-for="ImpactTimeline" style="font-weight:700">Timeline of Impact Occurrence</label>
                    <input asp-for="ImpactTimeline" class="form-input"
                           placeholder="e.g. Immediate upon deployment to Production" />
                </div>

                <div class="form-group col-2">
                    <label asp-for="RecommendedStrategy" style="font-weight:700">
                        Recommended Strategy
                        <span style="font-weight:400;font-size:0.8rem">(to implement the requested change)</span>
                    </label>
                    <textarea asp-for="RecommendedStrategy" class="form-input" rows="3"
                              placeholder="e.g. Requirements Gathering, Design, Development, Testing, Deployment..."></textarea>
                </div>

                <div class="form-group col-1">
                    <label asp-for="CostResourceTime" style="font-weight:700">Cost / Resource / Time Requirements</label>
                    <textarea asp-for="CostResourceTime" class="form-input" rows="3"
                              placeholder="e.g. Estimated 2 days development. IT team only. No additional cost."></textarea>
                </div>

                <div class="form-group col-1">
                    <label asp-for="ExpectedOutcome" style="font-weight:700">
                        Expected Outcome
                        <span style="font-weight:400;font-size:0.8rem"></span>
                    </label>
                    <textarea asp-for="ExpectedOutcome" class="form-input" rows="3"
                              placeholder="e.g. Improved client communication, reduced follow-ups..."></textarea>
                </div>

            </div>
        </div>

        <!-- ══ SECTION 4: Detailed Assessment ══ -->
        <div class="form-section">
            <div class="section-header" style="background:#d9d9d9;border:1px solid #a6a6a6;padding:8px 12px;margin-bottom:0">
                <span class="section-num">04</span>
                <h2 style="margin:0;font-size:1rem">Detailed Change Request Assessment <span style="font-weight:400;font-size:0.85rem">(completed by Project Manager or appointed representative)</span></h2>
            </div>
            <div class="form-grid" style="border:1px solid #a6a6a6;border-top:none;padding:16px">

                <div class="form-group col-2">
                    <label asp-for="AssessmentAssignedTo" style="font-weight:700">Change Request Assessment Assigned To</label>
                    <input asp-for="AssessmentAssignedTo" class="form-input" placeholder="Name of the project manager or assigned person" />
                </div>

                <div class="form-group col-2">
                    <label asp-for="TasksAffected" style="font-weight:700">
                        Tasks Affected
                        <span style="font-weight:400;font-size:0.8rem">(affected tasks, benefits, resource requirements, schedule impact)</span>
                    </label>
                    <textarea asp-for="TasksAffected" class="form-input" rows="3"
                              placeholder="e.g. Email Trigger Development — Automated notification to clients — IT resources — Minimal schedule impact"></textarea>
                </div>

                <div class="form-group col-2">
                    <label asp-for="StakeholdersAffected" style="font-weight:700">
                        Stakeholders Affected
                        <span style="font-weight:400;font-size:0.8rem">(stakeholders, benefits/impacts, actions required)</span>
                    </label>
                    <textarea asp-for="StakeholdersAffected" class="form-input" rows="3"
                              placeholder="e.g. Valuation Admin — Reduced manual follow-ups — Validate email content"></textarea>
                </div>

                <div class="form-group col-2">
                    <label asp-for="OptionsConsidered" style="font-weight:700">
                        Options Considered
                        <span style="font-weight:400;font-size:0.8rem">(describe options, pros and cons of each)</span>
                    </label>
                    <textarea asp-for="OptionsConsidered" class="form-input" rows="3"
                              placeholder="Option 1: ... Pros: ... Cons: ..."></textarea>
                </div>

                <div class="form-group col-2">
                    <label asp-for="RecommendedActions" style="font-weight:700">Recommended Actions &amp; Action Plan</label>
                    <textarea asp-for="RecommendedActions" class="form-input" rows="4"
                              placeholder="1. Identify trigger&#10;2. Develop logic&#10;3. Test&#10;4. Deploy"></textarea>
                </div>

                <div class="form-group col-1">
                    <label asp-for="ImpactOnScope" style="font-weight:700">Impact on Scope / Quality / Performance</label>
                    <input asp-for="ImpactOnScope" class="form-input" placeholder="e.g. Minimal — enhancement to existing functionality" />
                </div>

                <div class="form-group col-1">
                    <label asp-for="ImpactOnSchedule" style="font-weight:700">Impact on Schedule</label>
                    <input asp-for="ImpactOnSchedule" class="form-input" placeholder="e.g. Extends timeline by approximately 3 days" />
                </div>

                <div class="form-group col-1">
                    <label asp-for="AdditionalResources" style="font-weight:700">Additional Resources Required</label>
                    <input asp-for="AdditionalResources" class="form-input" placeholder="e.g. None beyond current team" />
                </div>

                <div class="form-group col-1">
                    <label asp-for="AdditionalCost" style="font-weight:700">Additional Cost</label>
                    <input asp-for="AdditionalCost" class="form-input" placeholder="e.g. No additional significant costs" />
                </div>

            </div>
        </div>

        <!-- ══ SECTION 5: Deployment Plan ══ -->
        <div class="form-section">
            <div class="section-header" style="background:#d9d9d9;border:1px solid #a6a6a6;padding:8px 12px;margin-bottom:0">
                <span class="section-num">05</span>
                <h2 style="margin:0;font-size:1rem">Deployment Plan</h2>
            </div>
            <div class="form-grid" style="border:1px solid #a6a6a6;border-top:none;padding:16px">

                <div class="form-group col-1">
                    <label asp-for="DeploymentDate" style="font-weight:700">Recommended Implementation Start Date *</label>
                    <input asp-for="DeploymentDate" type="date" class="form-input" />
                    <span asp-validation-for="DeploymentDate" class="field-error"></span>
                </div>

                <div class="form-group col-1">
                    <label asp-for="DeploymentEndDate" style="font-weight:700">Recommended Implementation Completion Date</label>
                    <input asp-for="DeploymentEndDate" type="date" class="form-input" />
                </div>

                <div class="form-group col-1">
                    <label asp-for="DeploymentWindow" style="font-weight:700">Deployment Window</label>
                    <input asp-for="DeploymentWindow" class="form-input" placeholder="e.g. 22:00 - 02:00" />
                </div>

                <div class="form-group col-1">
                    <label asp-for="ImplementationLead" style="font-weight:700">Person(s) Responsible for Leading Implementation</label>
                    <input asp-for="ImplementationLead" class="form-input" placeholder="Name of person responsible" />
                </div>

                <div class="form-group col-2">
                    <label asp-for="TestPlan" style="font-weight:700">Test Plan</label>
                    <textarea asp-for="TestPlan" class="form-input" rows="3"
                              placeholder="How will you verify the change was successful? Functional testing, UAT, etc."></textarea>
                </div>

                <div class="form-group col-2">
                    <label asp-for="RollbackPlan" style="font-weight:700">Rollback Plan</label>
                    <textarea asp-for="RollbackPlan" class="form-input" rows="3"
                              placeholder="Steps to revert if deployment fails..."></textarea>
                </div>

            </div>
        </div>

    </div>

    @* <div class="form-actions" style="margin-top:24px;display:flex;gap:12px;justify-content:flex-end">
        <a href="/Dashboard" class="btn-secondary">Cancel</a>
        <button type="submit" class="btn-primary">Submit Change Request</button>
    </div> *@

    @if (isResubmit)
    {
        <div class="form-section" style="border:2px solid #d9d9d9;margin-top:0">
            <div class="section-header" style="background:#ede9fe;border:1px solid #d9d9d9;padding:8px 12px;margin-bottom:0">
                <span class="section-num" style="background:#d9d9d9;color:#fff">↻</span>
                <h2 style="margin:0;font-size:1rem;color:#d9d9d9">Your Response (required to resubmit)</h2>
            </div>
            <div style="padding:16px;border:1px solid #d9d9d9;border-top:none">
                <div class="form-group">
                    <label style="font-weight:700;font-size:0.82rem;text-transform:uppercase;
                                  letter-spacing:0.06em;color:#374151;display:block;margin-bottom:6px">
                        Describe the changes you have made or information you have provided *
                    </label>
                    <textarea name="DeveloperResponse" class="form-input" rows="4" required
                          placeholder="e.g. I have updated the impact description and added the rollback plan as requested by the manager..."
                          style="border-color:#d9d9d9"></textarea>
                </div>
            </div>
        </div>
    }

    <div class="form-actions" style="margin-top:24px;display:flex;gap:12px;justify-content:flex-end">
        <a href="@(isResubmit ? $"/ChangeRequests/Details/{Model.Id}" : "/Dashboard")" class="btn-secondary">
            Cancel
        </a>
        <button type="submit" class="btn-primary">
            @(isResubmit ? "↻ Save Changes & Resubmit" : "Submit Change Request")
        </button>
    </div>
</form>


@section Scripts {
    <script>
        function handleAppChange() {
            const dropdown = document.getElementById("appSelect");
            const textbox  = document.getElementById("appNameInput");

            if (dropdown.value === "Other") {
                textbox.style.display = "block";
                textbox.value = "";
                textbox.setAttribute("name", "ApplicationName");
                dropdown.removeAttribute("name");
                textbox.focus();
            } else {
                textbox.style.display = "none";
                textbox.value = dropdown.value;
                textbox.removeAttribute("name");
                dropdown.setAttribute("name", "ApplicationName");
            }
        }

        // On page load — restore selected value when editing/resubmitting
        document.addEventListener("DOMContentLoaded", function () {
            const dropdown    = document.getElementById("appSelect");
            const textbox     = document.getElementById("appNameInput");
            const currentVal  = textbox.value; // filled by asp-for binding

            if (!currentVal) {
                // New form — dropdown owns the name
                dropdown.setAttribute("name", "ApplicationName");
                textbox.removeAttribute("name");
                return;
            }

            // Check if current value is one of the dropdown options
            const match = Array.from(dropdown.options)
                               .find(o => o.value === currentVal && o.value !== "Other");

            if (match) {
                // Known system — select it in dropdown
                dropdown.value = currentVal;
                dropdown.setAttribute("name", "ApplicationName");
                textbox.removeAttribute("name");
                textbox.style.display = "none";
            } else {
                // Custom "Other" value — show textbox
                dropdown.value = "Other";
                dropdown.removeAttribute("name");
                textbox.setAttribute("name", "ApplicationName");
                textbox.style.display = "block";
            }
        });
    </script>
}
