@using Change_order.Models
@using Change_order.Services
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var crService = (IChangeRequestService)ViewBag.CrService;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle">Welcome back, <strong>@Model.CurrentUser?.FullName</strong> · @Model.CurrentUser?.Role.ToString()</p>
    </div>
    <a href="/ChangeRequests/Create" class="btn-primary">+ New Change Request</a>
</div>

<!-- Stats -->
<div class="stats-row">
    <div class="stat-card">
        <div class="stat-num">@Model.TotalCount</div>
        <div class="stat-label">Total</div>
    </div>
    <div class="stat-card stat-pending">
        <div class="stat-num">@Model.PendingCount</div>
        <div class="stat-label">Pending</div>
    </div>
    <div class="stat-card stat-approved">
        <div class="stat-num">@Model.ApprovedCount</div>
        <div class="stat-label">Approved</div>
    </div>
    <div class="stat-card stat-rejected">
        <div class="stat-num">@Model.RejectedCount</div>
        <div class="stat-label">Rejected</div>
    </div>
    <div class="stat-card stat-deployed">
        <div class="stat-num">@Model.DeployedCount</div>
        <div class="stat-label">Deployed</div>
    </div>
</div>

<!-- Table -->
<div class="table-card">
    <div class="table-header">
        <h2 class="table-title">Change Requests</h2>
        <div class="table-filters">
            <input type="text" id="tableSearch" placeholder="Search..." class="search-input" />
        </div>
    </div>

    @if (!Model.AllRequests.Any())
    {
        <div class="empty-state">
            <p>No change requests found.</p>
            <a href="/ChangeRequests/Create" class="btn-primary">Submit your first request</a>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="cr-table" id="crTable">
                <thead>
                    <tr>
                        <th>CR ID</th>
                        <th>Name</th>
                        <th>Application</th>
                        <th>Submitted By</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Deploy Date</th>
                        <th>Deployment</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cr in Model.AllRequests)
                    {
                        bool allowed = crService.IsDeploymentAllowed(cr);
                        <tr>
                            <td><span class="cr-id">@cr.CRId</span></td>
                            <td>@cr.Name</td>
                            <td>@cr.ApplicationName</td>
                            <td>@cr.DeveloperName</td>
                            <td><span class="badge @crService.GetPriorityBadgeClass(cr.Priority)">@cr.Priority</span></td>
                            <td><span class="badge @crService.GetStatusBadgeClass(cr.Status)">@cr.Status</span></td>
                            <td>@cr.DeploymentDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                @if (cr.Status == ChangeRequestStatus.Deployed)
                                {
                                    <span class="deploy-chip deployed">Deployed</span>
                                }
                                else if (allowed)
                                {
                                    <span class="deploy-chip allowed">Allowed</span>
                                }
                                else
                                {
                                    <span class="deploy-chip blocked">Blocked</span>
                                }
                            </td>
                            <td><a href="/ChangeRequests/Details/@cr.Id" class="btn-link">View →</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.getElementById('tableSearch').addEventListener('input', function() {
            const q = this.value.toLowerCase();
            document.querySelectorAll('#crTable tbody tr').forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
            });
        });
    </script>
}
