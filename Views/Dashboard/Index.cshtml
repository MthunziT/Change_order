@model DashboardViewModel
@using Change_order.Models
@using Change_order.Services
@{
    ViewData["Title"] = "Dashboard";
    var crService = (IChangeRequestService)ViewBag.CrService;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle">Welcome back, <strong>@Model.CurrentUser?.FullName</strong> · @Model.CurrentUser?.Role.ToString()</p>
    </div>
    <a href="/ChangeRequests/Create" class="btn-primary">+ New Change Request</a>
</div>

<!-- Stats -->
<div class="stats-row">
    <div class="stat-card">
        <div class="stat-num">@Model.TotalCount</div>
        <div class="stat-label">Total CRs</div>
    </div>
    <div class="stat-card stat-pending">
        <div class="stat-num">@Model.PendingCount</div>
        <div class="stat-label">Pending</div>
    </div>
    <div class="stat-card stat-approved">
        <div class="stat-num">@Model.ApprovedCount</div>
        <div class="stat-label">Approved</div>
    </div>
    <div class="stat-card stat-rejected">
        <div class="stat-num">@Model.RejectedCount</div>
        <div class="stat-label">Rejected</div>
    </div>
    <div class="stat-card stat-deployed">
        <div class="stat-num">@Model.DeployedCount</div>
        <div class="stat-label">Deployed</div>
    </div>
</div>

<!-- Table -->
<div class="table-card">
    <div class="table-header">
        <h2 class="table-title">Change Requests</h2>
        <input type="text" id="tableSearch" placeholder="Search..." class="search-input" />
    </div>

    @if (!Model.GroupedRequests.Any())
    {
        <div class="empty-state">
            <p>No change requests found.</p>
            <a href="/ChangeRequests/Create" class="btn-primary">Submit your first request</a>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="cr-table" id="crTable">
                <thead>
                    <tr>
                        <th>CR ID</th>
                        <th>Version</th>
                        <th>Name</th>
                        <th>Application</th>
                        <th>Submitted By</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Deploy Date</th>
                        <th>Deployment</th>
                        <th>Create New Version</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var group in Model.GroupedRequests)
                    {
                        var cr = group.Latest;
                        bool allowed = crService.IsDeploymentAllowed(cr);
                        var rowId = $"group-{cr.Id}";

                        <!-- Latest version row -->
                        <tr class="cr-main-row" data-group="@rowId">
                            <td>
                                <span class="cr-id">@cr.CRId</span>
                                @if (group.HasMultipleVersions)
                                {
                                    <button class="version-toggle" onclick="toggleVersions('@rowId')"
                                            title="@group.AllVersions.Count versions">
                                        ▾ @group.AllVersions.Count
                                    </button>
                                }
                            </td>
                            <td>
                                @cr.Version
                                @* <span class="version-badge">1.0</span> *@
                            </td>
                            <td>@cr.Name</td>
                            <td>@cr.ApplicationName</td>
                            <td>@cr.DeveloperName</td>
                            <td><span class="badge @crService.GetPriorityBadgeClass(cr.Priority)">@cr.Priority</span></td>
                            <td><span class="badge @crService.GetStatusBadgeClass(cr.Status)">@cr.Status</span></td>
                            <td>@cr.DeploymentDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (cr.Status == ChangeRequestStatus.Deployed)
                                {
                                    <span class="deploy-chip deployed">Deployed</span>
                                }
                                else if (allowed)
                                {

                                    <span class="deploy-chip allowed">Allowed</span>
                                }
                                else
                                {

                                    <span class="deploy-chip blocked">Blocked</span>
                                }
                            </td>
                            <td style="white-space:nowrap">
                                <a href="/ChangeRequests/Details/@cr.Id" class="btn-link">View</a>
                                @if (Model.CurrentUser?.WindowsUsername == cr.DeveloperUserId)
                                {
                                    <span style="color:#ccc;margin:0 4px">|</span>
                                    <a href="/Dashboard/NewVersion/@cr.Id" class="btn-link"
                                       style="color:#000000" title="Create new version">+ v@(NextVersion(cr.Version))</a>
                                }
                            </td>
                        </tr>

                        <!-- Previous versions — hidden by default -->
                        @if (group.HasMultipleVersions)
                        {
                            @foreach (var old in group.AllVersions.Where(v => v.Id != cr.Id).OrderByDescending(v => v.Version))
                            {
                                <tr class="cr-version-row" id="@rowId" style="display:none;background:#f9f9f9">
                                    <td style="padding-left:28px">
                                        <span class="cr-id" style="font-size:0.75rem;color:#666">@old.CRId</span>
                                    </td>
                                    <td><span class="version-badge version-old">v@old.Version</span></td>
                                    <td style="color:#666;font-size:0.82rem">@old.Name</td>
                                    <td style="color:#666;font-size:0.82rem">@old.ApplicationName</td>
                                    <td style="color:#666;font-size:0.82rem">@old.DeveloperName</td>
                                    <td><span class="badge @crService.GetPriorityBadgeClass(old.Priority)" style="opacity:0.7">@old.Priority</span></td>
                                    <td><span class="badge @crService.GetStatusBadgeClass(old.Status)" style="opacity:0.7">@old.Status</span></td>
                                    <td style="color:#666;font-size:0.82rem">@old.DeploymentDate.ToString("dd/MM/yyyy")</td>
                                    <td></td>
                                    <td><a href="/ChangeRequests/Details/@old.Id" class="btn-link" style="font-size:0.78rem">View</a></td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@functions {
    string NextVersion(string current)
    {
        if (int.TryParse(current, out int version))
            return (version + 1).ToString();

        return "2";
    }
}

@section Scripts {
    <script>
        function toggleVersions(groupId) {
            const rows = document.querySelectorAll(`tr[id="${groupId}"]`);
            rows.forEach(r => {
                r.style.display = r.style.display === 'none' ? 'table-row' : 'none';
            });
        }

        document.getElementById('tableSearch').addEventListener('input', function () {
            const q = this.value.toLowerCase();
            document.querySelectorAll('#crTable tbody tr.cr-main-row').forEach(row => {
                const match = row.textContent.toLowerCase().includes(q);
                row.style.display = match ? '' : 'none';
                // Hide child version rows when parent is hidden
                const groupId = row.dataset.group;
                document.querySelectorAll(`tr[id="${groupId}"]`).forEach(child => {
                    child.style.display = 'none';
                });
            });
        });
    </script>
}